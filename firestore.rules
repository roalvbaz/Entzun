rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esAdmin() { return logueado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function aprobado(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado'; }

    // Quién es administrador: un documento admins/<uid> que creas tú a mano en la consola (nadie puede escribirlo desde la app).
    match /admins/{uid} {
      allow read: if logueado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Ficha de cada usuario. Se crea siempre como 'pendiente'; solo un administrador cambia el estado.
    match /users/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || esAdmin());
      allow create: if logueado() && request.auth.uid == uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.keys().hasOnly(['nombre', 'email', 'estado', 'creado']);
      allow update, delete: if esAdmin();
    }

    // Progreso de cada usuario: solo lo ve y lo escribe él mismo, y solo si está aprobado.
    match /progreso/{uid} {
      allow read, write: if logueado() && request.auth.uid == uid && aprobado(uid)
                         && (request.method == 'get' || request.method == 'list' || request.method == 'delete'
                             || request.resource.data.keys().hasOnly(['estado', 'actualizado']));
    }
  }
}
